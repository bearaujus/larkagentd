# Create .env locally and supply your app settings.
DATABASE_URL=postgresql+psycopg://larkagentd:larkagentd@postgres:5432/larkagentd
LARK_APP_ID=
LARK_APP_SECRET=
LARK_CLI_VERSION=1.0.99
LARK_READ_BRAND=lark
DASHBOARD_ADMIN_EMAILS=admin@example.com
DASHBOARD_PUBLIC_URL=http://localhost:18080

# Set the same key for Gateway and tool service. Use a random base64-encoded 32-byte key.
CREDENTIAL_ENCRYPTION_KEY=
TOOL_SERVICE_KEY=
AGENT_API_KEY=
HERMES_MODEL=
HERMES_PROVIDER=custom
HERMES_OPENAI_ENDPOINT=
HERMES_API_KEY=
AVAILABLE_MODELS=
MODEL_REASONING_EFFORTS='{}'
VISION_MODELS=

# Optional. Leave the key empty when public search should be unavailable.
BRAVE_SEARCH_API_KEY=
KNOWLEDGE_MCP_SERVERS='{}'
GROUP_BRAIN_ENABLED=true
GROUP_BRAIN_MAX_HISTORY_DAYS=30

# Optional semantic recall. Use an approved OpenAI-compatible embeddings endpoint.
GROUP_BRAIN_EMBEDDING_BASE_URL=
GROUP_BRAIN_EMBEDDING_API_KEY=
GROUP_BRAIN_EMBEDDING_MODEL=text-embedding-v4
GROUP_BRAIN_EMBEDDING_DIMENSIONS=1024
GROUP_BRAIN_COLLECTION=group_brain_v1

GITLAB_READ_URL=
GITLAB_READ_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
